# ---------------------------------------------------------------------------
# Sevika — environment configuration
# Copy to .env for local development. On Vercel, add these in Project Settings.
# ---------------------------------------------------------------------------

# PostgreSQL 14+ with the PostGIS extension (Neon, Supabase, Railway… all work).
# Local dev: docker compose up -d  (starts postgis/postgis on :5432)
DATABASE_URL="postgresql://sevika:sevika@localhost:5432/sevika?schema=public"

# Auth.js — generate with:  openssl rand -base64 32
NEXTAUTH_SECRET="replace-me-with-a-long-random-string"
NEXTAUTH_URL="http://localhost:3000"

# Google Maps (artist map on /discover and artist profiles)
# https://console.cloud.google.com/apis/credentials → enable "Maps JavaScript API"
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""

# AWS S3 (primary storage for portfolio images/videos, certificates, avatars)
S3_REGION=""
S3_BUCKET_NAME=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# Cloudinary (optional fallback when S3 is not configured)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Upstash Redis (optional — rate limiting on auth & booking endpoints).
# When unset, Sevika runs fine without rate limiting.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# SMTP (optional — transactional email). When unset, emails are logged to the
# server console instead of being sent.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
EMAIL_FROM="Sevika <hello@sevika.app>"

# Public site URL (used in emails/notifications)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
