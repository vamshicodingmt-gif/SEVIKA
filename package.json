{
  "name": "sevika",
  "version": "1.0.0",
  "private": true,
  "description": "Sevika — a free marketplace connecting customers with beauty & grooming professionals. 0% commission. Payments are arranged directly between customers and professionals.",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "postinstall": "prisma generate || echo \"[postinstall] prisma generate skipped (will run during build)\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.637.0",
    "@aws-sdk/s3-request-presigner": "3.637.0",
    "@hookform/resolvers": "3.9.0",
    "@prisma/client": "5.19.1",
    "@radix-ui/react-avatar": "1.1.0",
    "@radix-ui/react-dialog": "1.1.1",
    "@radix-ui/react-dropdown-menu": "2.1.1",
    "@radix-ui/react-label": "2.1.0",
    "@radix-ui/react-popover": "1.1.1",
    "@radix-ui/react-scroll-area": "1.1.0",
    "@radix-ui/react-select": "2.1.1",
    "@radix-ui/react-separator": "1.1.0",
    "@radix-ui/react-slot": "1.1.0",
    "@radix-ui/react-switch": "1.1.0",
    "@radix-ui/react-tabs": "1.1.0",
    "@tanstack/react-query": "5.56.2",
    "@upstash/ratelimit": "2.0.4",
    "@upstash/redis": "1.34.3",
    "@vis.gl/react-google-maps": "1.4.0",
    "bcryptjs": "2.4.3",
    "class-variance-authority": "0.7.0",
    "clsx": "2.1.1",
    "date-fns": "3.6.0",
    "framer-motion": "11.5.4",
    "lucide-react": "0.441.0",
    "next": "14.2.35",
    "next-auth": "4.24.7",
    "next-themes": "0.3.0",
    "nodemailer": "6.9.15",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-hook-form": "7.53.0",
    "recharts": "2.12.7",
    "sonner": "1.5.0",
    "tailwind-merge": "2.5.2",
    "zod": "3.23.8",
    "zustand": "4.5.5"
  },
  "devDependencies": {
    "@types/bcryptjs": "2.4.6",
    "@types/node": "20.16.5",
    "@types/nodemailer": "6.4.16",
    "@types/react": "18.3.8",
    "@types/react-dom": "18.3.0",
    "@vitejs/plugin-react": "4.3.1",
    "autoprefixer": "10.4.20",
    "dotenv": "16.4.5",
    "eslint": "8.57.1",
    "eslint-config-next": "14.2.35",
    "postcss": "8.4.47",
    "prisma": "5.19.1",
    "sharp": "^0.33.5",
    "tailwindcss": "3.4.12",
    "tailwindcss-animate": "1.0.7",
    "tsx": "4.19.1",
    "typescript": "5.6.2",
    "vitest": "2.1.1"
